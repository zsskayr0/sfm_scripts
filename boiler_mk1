every 2 ticks do
-- Transfer water from WaterGen to Boiler bottom
input fluid::water from WaterGen TOP SIDE
output fluid::water to Boiler BOTTOM SIDE
-- Transfer steam from Boiler top to SteamTank
input gas:mekanism:steam from Boiler TOP SIDE
output gas:mekanism:steam to TankSteam BOTTOM SIDE
-- Transfer heated sodium from SodiumTankH top to Boiler hot input
input gas:mekanism:superheated_sodium from TankSodiumH BOTTOM SIDE
